# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_resume_builder

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
# Locally: http://localhost:5173
# In production: your deployed frontend URL(s), comma-separated if you have several.
# NOTE: origins on *.vercel.app, *.onrender.com and *.netlify.app are auto-allowed
# by the CORS code. Any other custom domain MUST be listed here, e.g.
# https://my-app.onrender.com,https://my-custom-domain.com
# This deployment: frontend is hosted on Render, backend on Vercel.
CLIENT_URL=http://localhost:5173,https://ai-resume-builder-38iq.onrender.com

# OpenAI / Gemini API
OPENAI_API_KEY=your_openai_api_key_here
# If using Gemini, set the base URL to the Gemini-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Email (for forgot password) - use Gmail App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
