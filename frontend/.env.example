# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL — REQUIRED in production (e.g. on Render).
# If it is missing in a production build, the app falls back to
# https://ai-resume-builder-bambam05.vercel.app/api
# For local development the "/api" Vite proxy is used automatically.
#
# Local dev: http://localhost:5000/api
# Vercel:    https://ai-resume-builder-bambam05.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (must match the backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
